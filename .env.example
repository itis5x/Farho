# Appwrite (https://cloud.appwrite.io) — create a project, then an API key with
# databases/tables/columns/indexes/rows and buckets/files read+write scopes.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Root domain for store subdomains, e.g. farho.com -> mystore.farho.com
# Leave empty in development; stores are always reachable at /store/<slug>
ROOT_DOMAIN=

# Encrypts stored merchant/courier/channel credentials (32+ random characters)
SECRETS_KEY=
# Public base URL for payment returns and webhooks
PUBLIC_URL=

# Farho Pay (platform merchant accounts). Without eSewa keys, Farho Pay uses eSewa's test environment.
FARHO_ESEWA_PRODUCT_CODE=
FARHO_ESEWA_SECRET_KEY=
FARHO_KHALTI_SECRET_KEY=
FARHO_PAYMENTS_LIVE=false
FARHO_PAY_FEE_PERCENT=1.5

# Optional Claude shopping assistant
ANTHROPIC_API_KEY=
